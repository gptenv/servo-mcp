{
  "name": "servo-mcp",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A ChatGPT MCP App with a Servo WASM browser, multi-provider web search, and a global ChatGPT sidebar entrypoint.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/wrangler/bin/wrangler.js dev --ip 127.0.0.1 --port 8788 -c wrangler.jsonc -c servo-wasm/ports/servo-js-wasm/cloudflare-worker/wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "node --env-file-if-exists=.env node_modules/wrangler/bin/wrangler.js deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "4.1.11",
    "puppeteer-core": "^24.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.150.0"
  }
}
