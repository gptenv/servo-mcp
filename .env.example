# Fine-grained GitHub PAT scoped to gptenv/servo-wasm with Actions: Read.
# Used only by local npm run engine:fetch / npm run dev / npm run deploy.
SERVO_WASM_GITHUB_TOKEN=

# Optional for local Cloudflare deploys. GitHub Actions uses repository secrets
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
