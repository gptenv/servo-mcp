{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "servo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "src/vendor/servo-worker/servo_js_wasm.wasm",
        "src/vendor/h264-mp4-encoder.wasm"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "APP_NAME": "Servo MCP"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_SESSIONS", "class_name": "ServoBrowserSession" }
    ]
  },
  "migrations": [
    { "tag": "v1-servo-browser-sessions", "new_sqlite_classes": ["ServoBrowserSession"] }
  ]
}
